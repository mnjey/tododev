<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>稍后阅读</title>
  <meta name="description" content="自建稍后阅读：手机分享保存链接，电脑打开阅读">
  <meta name="theme-color" content="#4f46e5">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/icons/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icons/icon-180.png">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="topbar">
    <h1 class="logo">📚 稍后阅读</h1>
    <div class="topbar-actions">
      <button id="shareBtn" class="btn btn-ghost" type="button" title="分享本站">分享</button>
      <button id="addBtn" class="btn btn-primary" type="button">＋ 添加链接</button>
    </div>
  </header>

  <form id="addForm" class="add-form hidden" action="/bookmarks" method="post">
    <input type="url" name="url" id="urlInput" placeholder="粘贴链接，例如 https://example.com/article" required autocomplete="off" spellcheck="false">
    <div class="add-form-row">
      <input type="text" name="title" placeholder="标题（可选，留空自动抓取）" autocomplete="off">
      <button class="btn btn-primary" type="submit">保存</button>
    </div>
  </form>

  <nav class="tabs" role="tablist">
    <a class="tab <%= filter === 'all' ? 'active' : '' %>" href="/?filter=all">全部 <span class="count"><%= counts.all %></span></a>
    <a class="tab <%= filter === 'unread' ? 'active' : '' %>" href="/?filter=unread">未读 <span class="count"><%= counts.unread %></span></a>
    <a class="tab <%= filter === 'read' ? 'active' : '' %>" href="/?filter=read">已读 <span class="count"><%= counts.read %></span></a>
  </nav>

  <main>
    <% if (items.length === 0) { %>
      <div class="empty">
        <p class="empty-icon">🗂️</p>
        <p class="empty-text"><%= filter === 'all' ? '还没有保存任何链接' : filter === 'read' ? '还没有已读的链接' : '待读列表是空的，去收集吧' %></p>
        <p class="empty-hint">手机上打开本站 → 浏览器菜单「添加到主屏幕」→ 之后在任意网页的<b>分享菜单</b>里选「稍后阅读」，链接就存进来了。</p>
      </div>
    <% } else { %>
      <ul class="list">
        <% items.forEach(function (it) { %>
          <li class="item <%= it.is_read ? 'read' : 'unread' %>" data-id="<%= it.id %>">
            <a class="item-main" href="<%= it.url %>" target="_blank" rel="noopener noreferrer">
              <span class="dot" aria-hidden="true"></span>
              <span class="item-body">
                <span class="item-title"><%= it.title %></span>
                <span class="item-meta">
                  <span class="host"><%= it.host %></span>
                  <span class="time" data-time="<%= it.created_at %>"><%= it.created_at %></span>
                </span>
              </span>
            </a>
            <div class="item-actions">
              <button class="act act-read" data-act="toggle-read" type="button" title="标记已读 / 未读">✓</button>
              <button class="act act-del" data-act="delete" type="button" title="删除">✕</button>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </main>

  <footer class="foot">
    <a href="<%= baseUrl %>/healthz" class="foot-link" target="_blank" rel="noopener">服务状态</a>
    <span class="foot-dot">·</span>
    <span>自建稍后阅读 · 数据存于本机 SQLite</span>
  </footer>

  <script src="/app.js"></script>
</body>
</html>
